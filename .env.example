# Copy to .env and fill in. Never commit the real .env file.

# Optional: raises Binance/ccxt rate limits; public OHLCV works without keys
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional: higher rate limits / historical depth for on-chain and news data
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=
NEWSAPI_KEY=

# MLflow tracking (defaults to local ./mlruns if unset)
MLFLOW_TRACKING_URI=

# Reddit sentiment (via praw) - optional
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=btcpred-research
